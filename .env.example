# CORS - Frontend origins (comma-separated for multiple)
Cors__AllowedOrigins=https://miportfolio.com,http://localhost:4321

# JWT - Should be at least 32 characters
Jwt__Secret=TuClaveSecretaSuperSeguraDeAlMenos32Caracteres!
Jwt__Issuer=AJNPortfolio
Jwt__Audience=AJNPortfolioAdmin
Jwt__ExpirationMinutes=600

# Bootstrap token for initial admin registration
Bootstrap__Token=TuTokenBootstrapSeguro!

# Connection string de la base SQLite (ruta relativa al directorio de trabajo)
ConnectionStrings__DefaultConnection=DataSource=portfolio.db

# Aplica las migraciones de EF Core automaticamente al arrancar
Database__AutoMigrate=true

# URL en la que escucha Kestrel
ASPNETCORE_URLS=http://localhost:5000
